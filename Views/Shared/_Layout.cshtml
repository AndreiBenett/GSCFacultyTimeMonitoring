<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="theme-color" content="#123f8c" />

    <title>@ViewData["Title"] - GSC Faculty Time-In</title>


    <link rel="icon" type="image/png" href="~/images/gsc-logo.png" />


    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />


    <!-- Custom CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>


<body>


    <header class="app-header no-print">

        <nav class="navbar navbar-expand-lg navbar-dark container-xl py-3">


            <a class="navbar-brand d-flex align-items-center gap-3"
               asp-controller="Home"
               asp-action="Index">


                <img src="~/images/gsc-logo.png"
                     class="brand-logo"
                     alt="Good Samaritan Colleges logo" />


                <span class="brand-text">

                    <strong>
                        Good Samaritan Colleges
                    </strong>

                    <small>
                        Faculty Time-In Monitoring
                    </small>

                </span>


            </a>



            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNav"
                    aria-controls="mainNav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>




            <div class="collapse navbar-collapse"
                 id="mainNav">


                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2 pt-3 pt-lg-0">


                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            Time-In

                        </a>

                    </li>



                    @if (User.Identity?.IsAuthenticated == true)
                    {

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Admin"
                               asp-action="Index">

                                Dashboard

                            </a>

                        </li>



                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Admin"
                               asp-action="Attendance">

                                Attendance

                            </a>

                        </li>



                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="PeriodReport" asp-route-period="weekly">Weekly Report</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="PeriodReport" asp-route-period="monthly">Monthly Report</a>
                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="FacultyAdmin"
                               asp-action="Index">

                                Faculty

                            </a>

                        </li>



                        <li class="nav-item dropdown">


                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown">

                                @User.Identity.Name

                            </a>



                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">


                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Account"
                                       asp-action="ChangePassword">

                                        Change password

                                    </a>

                                </li>


                                <li>

                                    <hr class="dropdown-divider" />

                                </li>


                                <li>


                                    <form asp-controller="Account"
                                          asp-action="Logout"
                                          method="post"
                                          class="px-2">


                                        <button class="dropdown-item text-danger"
                                                type="submit">

                                            Sign out

                                        </button>


                                    </form>


                                </li>


                            </ul>


                        </li>

                    }

                    else
                    {

                        <li class="nav-item">


                            <a class="btn btn-sm btn-outline-light px-3 ms-lg-2"
                               asp-controller="Account"
                               asp-action="Login">

                                Admin Login

                            </a>


                        </li>

                    }


                </ul>


            </div>


        </nav>


    </header>





    <main class="page-shell">


        @if (TempData["AdminSuccess"] is string adminSuccess)
        {

            <div class="container-xl pt-3 no-print">

                <div class="alert alert-success premium-alert">

                    ✓ @adminSuccess

                </div>

            </div>

        }



        @if (TempData["AdminInfo"] is string adminInfo)
        {

            <div class="container-xl pt-3 no-print">

                <div class="alert alert-info premium-alert">

                    @adminInfo

                </div>

            </div>

        }



        @RenderBody()


    </main>





    <footer class="app-footer no-print">


        <div class="container-xl d-flex flex-column flex-md-row justify-content-between gap-2 py-4">


            <div>

                <strong>
                    Good Samaritan Colleges
                </strong>

                <br />

                <span>
                    Faculty Time-In Monitoring System
                </span>

            </div>




            <div class="text-md-end">


                <span>
                    Powered by <strong class="footer-credit-name">Mr. Andrei Benett P. Dela Cruz</strong><span class="footer-credit-role"> - Junior High School Faculty</span>
                </span>


                <br />


                <span class="footer-small-text">GSC Personnel Time-In Monitoring</span>


            </div>


        </div>


    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


    <!-- Custom JS -->
    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    <!-- Page Scripts -->
    @await RenderSectionAsync("Scripts", required: false)



</body>

</html>