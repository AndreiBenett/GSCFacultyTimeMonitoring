@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}
<div class="container-xl py-4 py-lg-5">
    <div class="panel-card mx-auto" style="max-width:640px">
        <div class="mb-4">
            <div class="system-kicker">Security</div>
            <h1 class="h3 mb-2">Change administrator password</h1>
            <p class="text-secondary mb-0">Use at least 12 characters. Avoid reusing a password from another service.</p>
        </div>
        <form asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger premium-alert"></div>
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label"></label>
                <input asp-for="CurrentPassword" class="form-control" />
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <button class="btn btn-primary" type="submit">Update Password</button>
            <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>
